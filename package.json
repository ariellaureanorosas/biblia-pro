{
  "name": "biblia-pro",
  "version": "1.0.1",
  "private": true,
  "description": "Bíblia PRO — plugin de Bíblia, favoritos e projeção para o Spresenter.",
  "license": "MIT",
  "author": "Ariel Laureano Rosas",
  "repository": {
    "type": "git",
    "url": "https://github.com/ariellaureanorosas/biblia-pro.git"
  },
  "homepage": "https://github.com/ariellaureanorosas/biblia-pro#readme",
  "bugs": {
    "url": "https://github.com/ariellaureanorosas/biblia-pro/issues"
  },
  "keywords": [
    "spresenter",
    "plugin",
    "bible",
    "biblia",
    "projecao",
    "favoritos"
  ],
  "type": "module",
  "scripts": {
    "build:code": "vite build --config vite.code.config.ts",
    "build:ui": "vite build --config vite.ui.config.ts",
    "build": "npm run build:code && npm run build:ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:watch": "vitest",
    "package": "npm run build && node scripts/package.mjs",
    "dev": "concurrently -k \"npm:watch:code\" \"npm:watch:ui\"",
    "watch:code": "vite build --watch --config vite.code.config.ts",
    "watch:ui": "vite build --watch --config vite.ui.config.ts"
  },
  "dependencies": {
    "@spresenter/plugin-sdk": "file:sdk/spresenter-plugin-sdk.tgz",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "adm-zip": "^0.5.17",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.2.0",
    "vitest": "^3.2.7"
  }
}
